---
interface Props { monochrome?: boolean; class?: string }
const { monochrome = false, class: className = '' } = Astro.props;
---
<!-- 기존 CodexSwitchIcon.swift의 교차 곡선과 네 노드 좌표를 그대로 옮긴 벡터 마크. -->
<span class:list={['app-mark', { 'mark-monochrome': monochrome }, className]} aria-hidden="true">
  <svg viewBox={monochrome ? '17 23 66 54' : '0 0 100 100'} fill="none">
    <path d="M29 35C48 35 52 65 71 65M29 65C48 65 52 35 71 35" stroke="currentColor" stroke-width="6.5" stroke-linecap="round" />
    <g fill="currentColor"><circle cx="27" cy="35" r="6.5" /><circle cx="27" cy="65" r="6.5" /><circle cx="73" cy="35" r="6.5" /><circle cx="73" cy="65" r="6.5" /></g>
  </svg>
</span>
